// Overheard LED: draws the chosen character or animation skin on the 8x13 matrix.
// The Linux side (python/main.py) tells this sketch which character, how busy the network is and how bright.
#include <Arduino_RouterBridge.h>
#include <Arduino_LED_Matrix.h>
#include "sprites.h"   // generated by tools/build_sprites.py

Arduino_LED_Matrix matrix;

static volatile int g_char = 0;     // index into SPRITES
static volatile int g_level = 0;    // 0 sit, 1 walk, 2 run, 3 sprint
static volatile int g_bright = 255; // 10..255

// frame time in ms for each level; sitting breathes slowly
static const unsigned long FRAME_MS[4] = {700, 220, 130, 80};
// animation skins (index >= CHAR_COUNT) loop their baked frames at a fixed rate, whatever the network level
static const unsigned long ANIM_MS = 120;

void set_state(int character, int level, int brightness) {
  if (character >= 0 && character < SPRITE_COUNT) g_char = character;
  if (level >= 0 && level <= 3) g_level = level;
  if (brightness >= 10 && brightness <= 255) g_bright = brightness;
}

void setup() {
  matrix.begin();
  matrix.setGrayscaleBits(8);
  Bridge.begin();
  Bridge.provide("set_state", set_state);
}

void loop() {
  static unsigned long last = 0;
  static int step = 0;
  const unsigned long now = millis();
  const int level = g_level;
  const int ch = g_char;
  const bool anim = ch >= CHAR_COUNT;
  if (now - last < (anim ? ANIM_MS : FRAME_MS[level])) return;
  last = now;
  step++;

  // sitting alternates the two breathing frames, otherwise cycle the four run frames
  uint8_t buf[104];
  const uint8_t* src;
  if (anim) {
    const int a = ch - CHAR_COUNT;
    src = ANIM_DATA[ANIM_START[a] + step % ANIM_LEN[a]];
  } else {
    const int frame = (level == 0) ? RUN_FRAMES + (step & 1) : step % RUN_FRAMES;
    src = SPRITES[ch][frame];
  }
  const int bright = g_bright;
  for (int i = 0; i < 104; i++) buf[i] = (uint8_t)((src[i] * bright) / 255);
  matrix.draw(buf);
}
